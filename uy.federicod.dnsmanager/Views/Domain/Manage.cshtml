@using uy.federicod.dnsmanager.logic.Models
@model DomainModel
@{
    ViewData["Title"] = "Manage Domain";
    string? successMessage = ViewBag.SuccessMessage as string;
    string? errorMessage = ViewBag.ErrorMessage as string;
    string attemptedRecordType = ViewBag.AttemptedRecordType as string ?? "A";
    string attemptedRecordName = ViewBag.AttemptedRecordName as string ?? string.Empty;
    string attemptedRecordContent = ViewBag.AttemptedRecordContent as string ?? string.Empty;
    string attemptedRecordPriority = ViewBag.AttemptedRecordPriority as string ?? "10";
    bool reopenAddRecord = ViewBag.AttemptedRecordType is string;
}
<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@(Model.DomainName).@Model.ZoneName</h5>
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert" tabindex="-1" id="dnsRecordError">@errorMessage</div>
}
@if (Model.DelegationType == "Hosted")
{
    @if (string.Equals(Model.HostedRecordType, "CNAME", StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-info" role="status">
            The base hostname uses CNAME. Add new records only below it, for example
            <strong>www.@Model.DomainName.@Model.ZoneName</strong>.
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addRecordPanel" aria-expanded="@(reopenAddRecord ? "true" : "false")" aria-controls="addRecordPanel">
                Add record
            </button>
        </div>
    </div>

    <div class="collapse @(reopenAddRecord ? "show" : string.Empty)" id="addRecordPanel">
        <div class="card card-body">
            <form asp-controller="Domain" asp-action="AddHostedRecord" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ZoneName" value="@Model.ZoneName" />
                <input type="hidden" name="DomainName" value="@Model.DomainName" />

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Type</label>
                    <div class="col-sm-4">
                        <select class="form-select" name="RecordType" id="recordTypeSelect" onchange="onTypeChange()">
                            <option value="A" selected="@(attemptedRecordType == "A")">A</option>
                            <option value="CNAME" selected="@(attemptedRecordType == "CNAME")">CNAME</option>
                            <option value="TXT" selected="@(attemptedRecordType == "TXT")">TXT</option>
                            <option value="MX" selected="@(attemptedRecordType == "MX")">MX</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Name</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" name="RecordName" value="@attemptedRecordName" aria-describedby="recordNameHelp" autocomplete="off" spellcheck="false" placeholder="@($"sub or sub.{Model.DomainName}.{Model.ZoneName}")" />
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted" id="recordNameHelp">Enter a short name or the complete DNS name. A final dot is optional.</small>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Content</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" name="RecordContent" id="recordContent" value="@attemptedRecordContent" aria-describedby="recordContentHelp" autocomplete="off" spellcheck="false" />
                        <div class="form-text" id="recordContentHelp"></div>
                    </div>
                </div>

                <div class="row mb-3" id="priorityRow" style="display:none;">
                    <label class="col-sm-2 col-form-label">Priority</label>
                    <div class="col-sm-4">
                        <input type="number" class="form-control" name="RecordPriority" min="0" value="@attemptedRecordPriority" />
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted">Priority for MX records, lower is higher priority.</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12 d-flex gap-2">
                        <button class="btn btn-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#addRecordPanel">Cancel</button>
                        <button class="btn btn-success" type="submit">Add record</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <hr />

    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Name</th>
                    <th>Content</th>
                    <th style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
@{
    var records = ViewBag.Records as List<uy.federicod.dnsmanager.logic.Models.DnsRecordModel> ?? new();
}
@foreach (var r in records)
{
    <tr>
        <td>
            @r.Type
            @if (r.IsBaseRecord)
            {
                <span class="badge bg-light text-dark">Base record</span>
            }
        </td>
        <td>@r.Name</td>
        <td>@r.Content</td>
        <td>
            @if (r.Deletable)
            {
                <form asp-controller="Domain" asp-action="DeleteHostedRecord" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ZoneName" value="@Model.ZoneName" />
                    <input type="hidden" name="DomainName" value="@Model.DomainName" />
                    <input type="hidden" name="RecordId" value="@r.Id" />
                    <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-sm" disabled>Locked</button>
            }
        </td>
    </tr>
}
            </tbody>
        </table>
    </div>
}

                    @if (Model.DelegationType == "Delegated")
                    {
                        <div class="row mb-3">
                            <ul class="list-group">
                                <li class="list-group-item active" aria-current="true">Your domain is Delegated on these Name Servers:</li>
                                @foreach (var ns in Model.NameServers)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@ns</span>
                                        <form asp-controller="Domain" asp-action="RemoveNameserver" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ZoneName" value="@Model.ZoneName" />
                                            <input type="hidden" name="DomainName" value="@Model.DomainName" />
                                            <input type="hidden" name="Nameserver" value="@ns" />
                                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>

                        <form asp-action="AddNameserver" asp-controller="Domain" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" value="@Model.ZoneName" name="ZoneName" />
                            <input type="hidden" value="@Model.DomainName" name="DomainName" />
                            <div class="row mb-3">
                                <label for="nameserver" class="col-sm-2 col-form-label">Add new</label>
                                <div class="col-sm-8">
                                    <input type="text" id="nameserver" name="Nameserver" class="form-control" placeholder="ns1.provider.tld." />
                                </div>
                                <div class="col-sm-2">
                                    <button type="submit" class="btn btn-primary">Add</button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function onTypeChange() {
        var t = document.getElementById('recordTypeSelect').value;
        var pr = document.getElementById('priorityRow');
        var content = document.getElementById('recordContent');
        var help = document.getElementById('recordContentHelp');
        if (t === 'MX') {
            pr.style.display = '';
        } else {
            pr.style.display = 'none';
        }

        if (t === 'A') {
            content.placeholder = '203.0.113.10';
            help.textContent = 'Enter an IPv4 address.';
        } else if (t === 'CNAME') {
            content.placeholder = '_token.provider.example.';
            help.textContent = 'Paste the complete target supplied by the provider. Underscores and a final dot are accepted.';
        } else if (t === 'MX') {
            content.placeholder = 'mail.provider.example.';
            help.textContent = 'Enter the complete mail server name. A final dot is optional.';
        } else {
            content.placeholder = 'Verification text supplied by the provider';
            help.textContent = 'Paste the TXT value exactly as supplied.';
        }
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', function(){
        onTypeChange();
        var error = document.getElementById('dnsRecordError');
        if (error) error.focus();
    });
</script>
