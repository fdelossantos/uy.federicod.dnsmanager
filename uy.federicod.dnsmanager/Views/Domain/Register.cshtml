@model uy.federicod.dnsmanager.Models.DomainRegistrationViewModel
@{
    ViewData["Title"] = "Register domain";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted mb-0">Choose who manages DNS and where the base hostname should point.</p>
</div>

<section class="section">
    <div class="row">
        <div class="col-xl-8 col-lg-9">
            <div class="card registration-panel">
                <div class="card-body">
                    <div class="registration-domain">
                        <span class="registration-eyebrow">Selected hostname</span>
                        <strong>@Model.DomainName.@Model.ZoneName</strong>
                    </div>

                    <form asp-action="Register" asp-controller="Domain" method="post" id="registerForm">
                        <input asp-for="DomainName" type="hidden" />
                        <input asp-for="ZoneName" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" tabindex="-1"></div>

                        <fieldset class="registration-section">
                            <legend>DNS management</legend>
                            <p class="text-muted">Keep records in DNS Manager or delegate the hostname to another provider.</p>

                            <div class="registration-choices" role="radiogroup" aria-label="DNS management">
                                <label class="registration-choice" for="managementHosted">
                                    <input asp-for="DelegationType" id="managementHosted" type="radio" value="Hosted" />
                                    <span>
                                        <strong>Managed here</strong>
                                        <small>Create and manage DNS records in this application.</small>
                                    </span>
                                </label>
                                <label class="registration-choice" for="managementDelegated">
                                    <input asp-for="DelegationType" id="managementDelegated" type="radio" value="Delegated" />
                                    <span>
                                        <strong>External name servers</strong>
                                        <small>Delegate this hostname to your own DNS provider.</small>
                                    </span>
                                </label>
                            </div>
                            <span asp-validation-for="DelegationType" class="text-danger"></span>
                        </fieldset>

                        <div id="hostedFields" class="registration-fields is-visible">
                            <fieldset class="registration-section">
                                <legend>Base record</legend>
                                <p class="text-muted">Choose the type that matches the application you are publishing.</p>

                                <div class="registration-choices registration-choices-inline" role="radiogroup" aria-label="Base record type">
                                    <label class="registration-choice" for="recordTypeA">
                                        <input asp-for="HostedRecordType" id="recordTypeA" type="radio" value="A" />
                                        <span>
                                            <strong>IP address <span class="badge bg-light text-dark">A</span></strong>
                                            <small>Point directly to an IPv4 address.</small>
                                        </span>
                                    </label>
                                    <label class="registration-choice" for="recordTypeCname">
                                        <input asp-for="HostedRecordType" id="recordTypeCname" type="radio" value="CNAME" />
                                        <span>
                                            <strong>Hostname alias <span class="badge bg-light text-dark">CNAME</span></strong>
                                            <small>Point to a hostname supplied by another platform.</small>
                                        </span>
                                    </label>
                                </div>
                                <span asp-validation-for="HostedRecordType" class="text-danger"></span>

                                <div class="mt-4">
                                    <label asp-for="HostedTarget" class="form-label" id="hostedTargetLabel">IPv4 address</label>
                                    <input asp-for="HostedTarget" class="form-control" id="hostedTarget" autocomplete="off" />
                                    <div class="form-text" id="hostedTargetHelp">Example: 203.0.113.10</div>
                                    <span asp-validation-for="HostedTarget" class="text-danger"></span>
                                </div>
                            </fieldset>
                        </div>

                        <div id="delegatedFields" class="registration-fields" hidden>
                            <fieldset class="registration-section">
                                <legend>Name servers</legend>
                                <p class="text-muted">Enter at least one fully qualified name server, separated by spaces or new lines.</p>
                                <label asp-for="Nameservers" class="form-label">External name servers</label>
                                <textarea asp-for="Nameservers" class="form-control" id="nameservers" rows="4" placeholder="ns1.provider.example&#10;ns2.provider.example"></textarea>
                                <span asp-validation-for="Nameservers" class="text-danger"></span>
                            </fieldset>
                        </div>

                        <div class="registration-actions">
                            <a asp-controller="Search" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button class="btn btn-primary" type="submit">Register domain</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const managementInputs = document.querySelectorAll('input[name="DelegationType"]');
            const recordTypeInputs = document.querySelectorAll('input[name="HostedRecordType"]');
            const hostedFields = document.getElementById('hostedFields');
            const delegatedFields = document.getElementById('delegatedFields');
            const hostedTarget = document.getElementById('hostedTarget');
            const hostedTargetLabel = document.getElementById('hostedTargetLabel');
            const hostedTargetHelp = document.getElementById('hostedTargetHelp');
            const nameservers = document.getElementById('nameservers');

            function selectedValue(inputs) {
                return Array.from(inputs).find(input => input.checked)?.value;
            }

            function setVisible(element, visible) {
                if (visible) {
                    element.hidden = false;
                    requestAnimationFrame(() => element.classList.add('is-visible'));
                    return;
                }

                element.classList.remove('is-visible');
                window.setTimeout(() => {
                    if (!element.classList.contains('is-visible')) element.hidden = true;
                }, 140);
            }

            function updateTargetCopy() {
                const isCname = selectedValue(recordTypeInputs) === 'CNAME';
                hostedTargetLabel.textContent = isCname ? 'Target hostname' : 'IPv4 address';
                hostedTarget.placeholder = isCname ? 'app.platform.example' : '203.0.113.10';
                hostedTarget.inputMode = isCname ? 'url' : 'decimal';
                hostedTargetHelp.textContent = isCname
                    ? 'Enter a fully qualified hostname without https://, a port, or a path.'
                    : 'Enter the public IPv4 address where this hostname should resolve.';
            }

            function updateManagementFields() {
                const isHosted = selectedValue(managementInputs) === 'Hosted';
                setVisible(hostedFields, isHosted);
                setVisible(delegatedFields, !isHosted);
                hostedTarget.required = isHosted;
                nameservers.required = !isHosted;
            }

            managementInputs.forEach(input => input.addEventListener('change', updateManagementFields));
            recordTypeInputs.forEach(input => input.addEventListener('change', updateTargetCopy));
            updateManagementFields();
            updateTargetCopy();

            const validationSummary = document.querySelector('.validation-summary-errors');
            if (validationSummary) validationSummary.focus();
        })();
    </script>
}
